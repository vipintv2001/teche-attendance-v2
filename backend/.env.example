# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=true

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/teche_attendance?retryWrites=true&w=majority

# Office Presence Verification (Wi-Fi Public IP + 100m GPS Fallback)
OFFICE_PUBLIC_IP=203.0.113.10
OFFICE_LAT=11.2588
OFFICE_LNG=75.7804
ALLOWED_RADIUS_METERS=100

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_strong_password
ADMIN_COOKIE_SECRET=change_this_random_hmac_secret

# Web Push VAPID Keys (Generate via: npx web-push generate-vapid-keys)
VAPID_SUBJECT=mailto:admin@techeeducation.com
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

